# Comma-separated subscription IDs the agent may query. Required.
AZURE_SUBSCRIPTION_IDS=00000000-0000-0000-0000-000000000000
# Client ID of the user-assigned managed identity (set in Azure; leave empty locally to use `az login`).
AZURE_CLIENT_ID=
# Hard cap on rows any single tool call returns to the model.
OPSAGENT_MAX_ROWS=1000
# Set to a directory to cache tool responses on disk (eval development only).
OPSAGENT_TOOL_CACHE_DIR=
